ARG VERSION=latest
# BASE_IMAGE is the image produced by Dockerfile.native-package. Release and nightly
# tags use VERSION; reusable builds override BASE_IMAGE with the digest-qualified
# native image they just published.
#
# That image is ubi9-micro and has no package manager, so this image cannot extend it.
ARG BASE_IMAGE=floci/floci-oci:${VERSION}
FROM ${BASE_IMAGE} AS native

# Everything that does not depend on the floci-oci version. CI can build this stage
# alone (target: tools) to warm the layer cache, pulling no floci-oci image.
FROM registry.access.redhat.com/ubi9-minimal:9.7 AS tools

LABEL org.opencontainers.image.title="floci-oci (compat)" \
      org.opencontainers.image.description="floci-oci compatibility image with the OCI CLI and Python SDK pre-installed" \
      org.opencontainers.image.url="https://floci.io" \
      org.opencontainers.image.source="https://github.com/floci-io/floci-oci" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="Floci"

ENV FLOCI_OCI_ENDPOINT=http://localhost:4599
# OCI_CLI_CONFIG_FILE is read by the CLI, OCI_CONFIG_FILE by the SDKs.
ENV OCI_CLI_CONFIG_FILE=/etc/floci-oci/oci/config
ENV OCI_CONFIG_FILE=/etc/floci-oci/oci/config

# No `pip install --upgrade pip`: the RPM's pip is current enough for these wheels
# and upgrading leaves a second, shadowing copy of pip in /usr/local.
RUN useradd -r -u 1001 -g root -d /app -s /sbin/nologin floci \
    && microdnf install -y --nodocs python3.11 python3.11-pip \
    && python3.11 -m pip install --no-cache-dir oci oci-cli \
    # The system Python keeps pip, setuptools and what the SDKs import; the optimised
    # .pyc variants, lib2to3 and ensurepip are build-time extras.
    && rm -rf /usr/lib64/python3.11/lib2to3 /usr/lib64/python3.11/ensurepip \
    && python3.11 -c 'import pathlib; [p.unlink() for d in ("/usr/lib64/python3.11","/usr/lib/python3.11") for p in pathlib.Path(d).rglob("*.opt-[12].pyc")]' \
    && microdnf clean all \
    && rm -rf /root/.cache/pip

COPY --chmod=755 bin/ocilocal /usr/local/bin/ocilocal

# Pre-create the init-hook directories so archive-based copies (Testcontainers
# withCopyFileToContainer / `docker cp`) can drop hooks straight into them.
# Docker's archive extract unpacks into an existing dir and never mkdir -p's
# the parents, so without these the copy fails. Paths match InitializationHook.
RUN mkdir -p /etc/floci-oci/init/boot.d /etc/floci-oci/init/start.d \
             /etc/floci-oci/init/ready.d /etc/floci-oci/init/stop.d \
             /etc/floci-oci/init/shutdown.d

# The OCI CLI refuses to run without an API key, so ship a throwaway one — the
# emulator parses signatures but never verifies them. Public by construction.
COPY docker/gen-oci-cli-config.py /tmp/gen-oci-cli-config.py
RUN python3.11 /tmp/gen-oci-cli-config.py \
    && rm /tmp/gen-oci-cli-config.py \
    && chown -R 1001:root /etc/floci-oci

WORKDIR /app
# A chmod after the copy below would rewrite the binary into a second layer.
RUN chown 1001:root /app && chmod g+rwX /app

FROM tools

ARG VERSION
ENV FLOCI_OCI_VERSION=${VERSION}
ENV FLOCI_OCI_STORAGE_PERSISTENT_PATH=/app/data

COPY --from=native --chown=1001:root /app/ /app/
VOLUME /app/data

COPY --from=native /usr/local/bin/docker-entrypoint.sh /usr/local/bin/
# From the build context, not the native image: a published native image may predate the script.
COPY --chmod=755 docker/healthcheck.sh /usr/local/bin/

# Tools that ignore the env vars and only look at ~/.oci/config — the Java SDK
# and the Terraform provider among them — need it at both homes: root (the
# image user, so `docker exec` works) and /app (the floci runtime user).
# After the /app copy above, so the symlink is not shadowed by it.
RUN mkdir -p /root/.oci /app/.oci \
    && ln -sf /etc/floci-oci/oci/config /root/.oci/config \
    && ln -sf /etc/floci-oci/oci/config /app/.oci/config \
    && chown -R 1001:root /app/.oci

EXPOSE 4599

HEALTHCHECK --interval=5s --timeout=3s --retries=5 CMD ["/usr/local/bin/healthcheck.sh"]

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["/app/application", "-Dquarkus.http.host=0.0.0.0"]

# No USER directive on purpose: the image stays root so entrypoint.sh can fix up
# /app/data ownership before dropping to uid 1001 through coreutils chroot.
